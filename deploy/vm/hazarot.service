[Unit]
Description=Hazarot team rehearsal simulator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hazarot
Group=hazarot
WorkingDirectory=/opt/hazarot
ExecStart=/opt/hazarot/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hazarot/app
UMask=0077

[Install]
WantedBy=multi-user.target
