{
  "name": "rehearsal-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "Rehearsal", "class_name": "Rehearsal" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Rehearsal"] }]
}
