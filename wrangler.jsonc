{
  "name": "rehearsal-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Rehearsal",
        "class_name": "Rehearsal"
      },
      {
        "name": "Character",
        "class_name": "Character"
      },
      {
        "name": "Authority",
        "class_name": "Authority"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Rehearsal"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Character"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Authority"]
    }
  ]
}
